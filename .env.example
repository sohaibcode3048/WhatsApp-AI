# Application Configuration
APP_NAME=whatsapp-ai-munshi
APP_ENV=development
DEBUG=true
PORT=8000
HOST=0.0.0.0
API_V1_PREFIX=/api/v1
SECRET_KEY=change-this-in-production-to-a-secure-random-key-at-least-32-chars

# Database Configuration (PostgreSQL)
# Format: postgresql+asyncpg://user:password@host:5432/db_name
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/munshi_db
DATABASE_SYNC_URL=postgresql://postgres:postgres@localhost:5432/munshi_db
DB_ECHO=false

# Docker PostgreSQL credentials (used by docker-compose)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=munshi_db

# Redis Configuration (Workers, Caching, Session Locking)
REDIS_URL=redis://localhost:6379/0

# Groq LLM API Configuration
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
LLM_PROVIDER=groq
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=1024

# Meta WhatsApp Cloud API Configuration
WHATSAPP_ACCESS_TOKEN=your_meta_system_user_access_token
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id
WHATSAPP_VERIFY_TOKEN=your_webhook_verification_token
WHATSAPP_APP_SECRET=your_meta_app_secret
WHATSAPP_API_VERSION=v21.0

# Vector Database (RAG) & Embeddings
CHROMA_HOST=localhost
CHROMA_PORT=8001
CHROMA_COLLECTION_PREFIX=munshi_shop_
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Security & Authentication (JWT for dashboard/admin APIs)
JWT_SECRET=super-secret-jwt-key-minimum-32-chars-long
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Speech-to-Text (STT) Configuration
# Provider: groq_whisper | mock
STT_PROVIDER=groq_whisper
STT_GROQ_MODEL=whisper-large-v3
STT_CONFIDENCE_THRESHOLD=0.6
STT_MAX_AUDIO_SIZE_MB=25

# Celery / Background Workers
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Business Harness Thresholds
LARGE_CREDIT_APPROVAL_THRESHOLD=10000.00
LARGE_DISCOUNT_APPROVAL_THRESHOLD=2000.00
DEFAULT_SHOP_CURRENCY=PKR
DEFAULT_SHOP_LANGUAGE=roman_urdu

# Conversation History (messages stored in Redis per sender per shop)
CONVERSATION_HISTORY_TTL=3600
CONVERSATION_HISTORY_MAX_TURNS=10
